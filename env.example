# AdrenaChain Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

#######################################
# SECURITY-HARDENED SETTINGS
#######################################

# Enable security monitoring (default: true)
SECURITY_MONITORING=true

# Enable rate limiting for API endpoints
RATE_LIMITING=true

# Enable CORS restrictions with specific origins only
CORS_ENABLED=true

# Enable CSRF protection
CSRF_PROTECTION=true

# Enable SQL injection prevention
SQL_INJECTION_PREVENTION=true

# Enable XSS filter
XSS_FILTER=true

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# Maximum concurrent connections per client
MAX_CONNECTIONS_PER_CLIENT=100

#######################################
# DATABASE CONFIGURATION
#######################################

# Use HTTPS connections to database when TLS is available
DB_TLS_ENABLED=true

# Connection pooling settings
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=50
DB_CONNECT_TIMEOUT=5

# Query timeout (seconds) - prevent slow query attacks
QUERY_TIMEOUT=30

#######################################
# API SECURITY
#######################################

# Rate limiting window (seconds)
RATE_LIMIT_WINDOW=60

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Enable request size validation
REQUEST_SIZE_LIMIT=true

#######################################
# AUTHENTICATION / AUTHORIZATION
#######################################

# Minimum password length
MIN_PASSWORD_LENGTH=12

# Password complexity requirements enabled
PASSWORD_COMPLEXITY=true

# Account lockout threshold (failed attempts)
ACCOUNT_LOCKOUT_THRESHOLD=5

# Account lockout duration (minutes)
ACCOUNT_LOCKOUT_DURATION=30

# Enable multi-factor authentication support
MFA_SUPPORTED=true

#######################################
# NETWORK SECURITY
#######################################

# Only allow localhost in development (set to false in production with specific IPs)
ALLOW_LOCALHOST_ONLY=false

# Enable firewalld/firewall management (requires root permissions)
FIREWALL_ENABLED=false

#######################################
# DEBUGGING / LOGGING
#######################################

# Set to "false" in production
DEBUG_MODE=false

# Detailed error messages in production? Set to false
DETAILED_ERRORS=false

# Log request bodies for debugging (disable in production)
LOG_REQUEST_BODIES=false
