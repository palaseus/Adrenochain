# Environment Variables Configuration
# Copy this file to .env for production use and fill in the secret values

APP_NAME="{{.AppName}}"
APP_ENV=production
LOG_LEVEL=info
DEBUG=false

# Database
DB_HOST={{.DbHost}}
DB_PORT=5432
DB_NAME={{.DbName}}
DB_USER={{.DbUser}}
DB_PASSWORD={{.DbPassword}}

# Admin API Endpoints (set via environment variables, not hardcoded)
ADMIN_API_ADDRESS={{.AdminApiAddress}}
WEBSOCKETS_ADMIN_ADDRESS={{.WebsocketsAdminAddress}}
HTTP_API_ADMIN_ADDRESS={{.HttpApiAdminAddress}}

# External Services
REDIS_HOST={{.RedisHost}}
REDIS_PASSWORD={{.RedisPassword}}

# SSL/TLS
SSL_CERT_PATH={{.SslCertPath}}
SSL_KEY_PATH={{.SslKeyPath}}

# JWT
JWT_SECRET={{.JwtSecret}}

# API Keys
API_SECRET_KEY={{.ApiSecretKey}}
