{
  "name": "adrenochain-sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for Adrenochain blockchain",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "blockchain",
    "adrenochain",
    "defi",
    "cryptocurrency",
    "web3"
  ],
  "author": "Adrenochain Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "ethers": "^6.8.0",
    "bn.js": "^5.2.1",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/crypto-js": "^4.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/palaseus/adrenochain.git",
    "directory": "sdk/javascript"
  },
  "bugs": {
    "url": "https://github.com/palaseus/adrenochain/issues"
  },
  "homepage": "https://github.com/palaseus/adrenochain#readme"
}
